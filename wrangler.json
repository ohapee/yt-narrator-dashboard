{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yt-narrator-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "dev": {
    "ip": "0.0.0.0",
    "port": 8787
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "JOBS",
        "class_name": "NarrationCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-jobs",
      "new_sqlite_classes": [
        "NarrationCoordinator"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "PUBLIC_VIDEOS",
      "bucket_name": "yt-narrator-public-videos"
    }
  ]
}
