{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yt-narrator-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "JOBS",
        "class_name": "NarrationCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-jobs",
      "new_sqlite_classes": [
        "NarrationCoordinator"
      ]
    }
  ]
}
