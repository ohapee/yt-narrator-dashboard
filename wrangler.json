{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yt-narrator-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
