{
  "name": "yt-narrator-dashboard",
  "version": "1.0.0",
  "description": "YouTube ナレーション・8コマ漫画自動生成プロジェクトの進捗・成果物管理ダッシュボード",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "start": "wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "wrangler deploy src/index.js --assets=./public",
    "test:browser": "playwright test",
    "generate:visuals": "node scripts/generate-visuals.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "wrangler": "^4.149.0"
  }
}
